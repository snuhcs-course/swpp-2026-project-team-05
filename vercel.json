{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "fluid": true,
  "regions": ["icn1"],
  "functions": {
    "server/wsgi.py": {
      "maxDuration": 300,
      "excludeFiles": "{android/**,tests/**,deploy/**,docs/**,examples/**,.env*,.venv/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
