# Copy to .env, fill in values, then source it in your local shell.
GOOGLE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Iteration 2 comparison and rubric pipeline. Set v1 only to reproduce Iteration 1.
FRAMELESS_PIPELINE=v2
# Optional settings for controlled Gemini runs.
GEMINI_TEMPERATURE=1.0
GEMINI_SEED=42
# EC2 deployment only: HTTPS domain pointing to the instance and a random Django key.
SERVER_DOMAIN=
DJANGO_SECRET_KEY=
