# Copy to .env, fill in values, then source it in your local shell.
GOOGLE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Required when DJANGO_ENV=production; share only with team members.
ANALYZE_ACCESS_TOKEN=

# EC2 deployment only: HTTPS domain pointing to the instance and a random Django key.
SERVER_DOMAIN=
DJANGO_SECRET_KEY=
