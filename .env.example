# Copy to .env, fill in values, then source it in your local shell.
# Team analysis uses OpenRouter credits. Keep this value server-side only.
OPENROUTER_API_KEY=
# Optional direct Gemini fallback for local experiments.
GOOGLE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# OpenRouter defaults: 3.8 Flash for semantic judgments, 3.1 Flash Lite for metadata.
# OPENROUTER_QUALITY_MODEL=google/gemini-3.8-flash
# OPENROUTER_METADATA_MODEL=google/gemini-3.1-flash-lite
# Candidate-body verifier uses medium by default; low is for measured comparison runs only.
# OPENROUTER_VERIFIER_REASONING_EFFORT=low
# OPENROUTER_TEMPERATURE=1.0
# OPENROUTER_SEED=42
# Direct Gemini overrides used only when OpenRouter is not configured.
# GEMINI_QUALITY_MODEL=gemini-3.8-flash
# GEMINI_METADATA_MODEL=gemini-3.1-flash-lite
# Optional second discovery source; requires Google Search grounding quota.
# ENABLE_GOOGLE_GROUNDED_SEARCH=1
# GOOGLE_GROUNDED_SEARCH_MODEL=gemini-3.8-flash
# Full-text Reader analysis. Set v1 only to reproduce Iteration 1 locally.
FRAMELESS_PIPELINE=v2
# Optional settings for controlled Gemini runs.
GEMINI_TEMPERATURE=1.0
GEMINI_SEED=42
# EC2 deployment only: HTTPS domain pointing to the instance and a random Django key.
SERVER_DOMAIN=
DJANGO_SECRET_KEY=
